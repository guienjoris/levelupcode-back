# Environment
PORT=3000
NODE_ENV=development

# Supabase PostgreSQL Configuration
# DATABASE_URL: Transaction pooler (port 6543) for runtime queries
DATABASE_URL="postgresql://postgres:postgres@localhost:6543/postgres?pgbouncer=true"
# DIRECT_URL: Direct connection (port 5432) for Prisma migrations
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# JWT Authentication
JWT_SECRET="change-this-super-secret-jwt-key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-this-super-secret-refresh-key"
JWT_REFRESH_EXPIRES_IN="7d"

# OAuth2 (Optional for local dev)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3000/auth/github/callback"

# Administrator & Error Reporting
ADMIN_EMAIL="admin@levelupcode.dev"

# Cloud Scheduler & Notifications
CRON_SECRET="change-this-cron-secret-token"

# Mail Provider (Resend / Nodemailer)
RESEND_API_KEY=""
MAIL_FROM="LevelUpCode <noreply@levelupcode.dev>"

# Buy Me a Coffee Webhook
BMC_WEBHOOK_SECRET=""
